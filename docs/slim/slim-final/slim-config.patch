+++ b/data/conf/dovecot/extra.conf
@@ -0,0 +1,19 @@
+# SLIM: dovecot overrides. Included by tracked dovecot.conf line 306 (!include_try /etc/dovecot/extra.conf); file is gitignored (.gitignore:15), so no merge conflicts.
+# Service blocks here merge with those in dovecot.conf (later wins). Global default_* settings do NOT work here: dovecot.conf sets default_client_limit/default_vsz_limit at lines 310-311, AFTER this include.
+# Expected effect: fewer pre-forked login processes (~5-10MB saved each) and capped IMAP session fan-out. Total saving est. 10-40MB. Not runtime-verified.
+service imap-login {
+  process_min_avail = 1
+  process_limit = 100
+}
+service managesieve-login {
+  process_min_avail = 0
+}
+service pop3-login {
+  process_min_avail = 0
+}
+service imap {
+  process_limit = 200
+}
+auth_cache_size = 2M
+mail_max_userip_connections = 50
+# RISK: managesieve/pop3 first connection is slower (process spawn). mail_max_userip_connections=50 would reject a client opening >50 IMAP connections for one user from one IP (tracked value 500, dovecot.conf:271).
